{
	"name": "ka-vlan",
	"version": "1.0.0",
	"author": "Kuzuki Azusa",
	"description": "基于 WireGuard 的 Windows 虚拟局域网组网工具，支持一键创建或加入网络，实现多设备安全互联。",
	"license": "MIT",
	"homepage": "https://github.com/cirnotsuki/ka-vlan",
	"main": "./dist/main.js",
	"scripts": {
		"dev": "node .electron-vue/dev-runner.js",
		"build": "node .electron-vue/build.js",
		"pack": "npm run build && electron-builder --dir",
		"builder": "electron-builder --dir",
		"sign": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/signpath-sign.ps1 -Files \"dist/ka-vlan/win-unpacked/KA VLAN.exe\",\"dist/ka-vlan/win-unpacked/resources/core/vlancore.exe\"",
		"release": "npm run pack && npm run sign"
	},
	"build": {
		"appId": "com.vlan.app",
		"productName": "ka-vlan",
		"directories": {
			"output": "./dist/ka-vlan"
		},
		"files": [
			"dist/**/*",
			"static/**/*",
			"package.json",
			"!core/**"
		],
		"extraResources": [
			{
				"from": "core/",
				"to": "core",
				"filter": [
					"vlancore.exe",
					"sqlite3.exe",
					"wg/wireguard.exe",
					"wg/wg.exe"
				]
			}
		],
		"asar": true,
		"electronDist": "node_modules/electron/dist",
		"win": {
			"target": [
				"dir"
			],
			"icon": "static/icon.ico"
		}
	},
	"devDependencies": {
		"ajv": "^6.5.0",
		"asar": "^2.1.0",
		"babel-core": "^6.26.3",
		"babel-helper-vue-jsx-merge-props": "^2.0.3",
		"babel-loader": "^7.1.4",
		"babel-minify-webpack-plugin": "^0.3.1",
		"babel-plugin-syntax-jsx": "^6.18.0",
		"babel-plugin-transform-runtime": "^6.23.0",
		"babel-plugin-transform-vue-jsx": "^3.7.0",
		"babel-preset-env": "^1.7.0",
		"babel-preset-stage-0": "^6.24.1",
		"babel-register": "^6.26.0",
		"cfonts": "^2.8.1",
		"chalk": "^2.4.2",
		"cheerio": "^1.0.0-rc.10",
		"copy-webpack-plugin": "^4.5.1",
		"cross-env": "^7.0.3",
		"css-loader": "^0.28.11",
		"del": "^3.0.0",
		"devtron": "^1.4.0",
		"electron": "22.3.21",
		"electron-builder": "^20.19.2",
		"electron-debug": "^1.5.0",
		"electron-devtools-installer": "^2.2.4",
		"eslint": "^7.21.0",
		"eslint-config-airbnb-base": "^14.2.1",
		"eslint-plugin-import": "^2.22.1",
		"eslint-plugin-vue": "^7.7.0",
		"file-loader": "^1.1.11",
		"html-webpack-plugin": "^3.2.0",
		"js-beautify": "^1.14.0",
		"less": "^3.11.1",
		"less-loader": "^5.0.0",
		"mini-css-extract-plugin": "0.4.0",
		"multispinner": "^0.2.1",
		"node-loader": "^0.6.0",
		"png-to-ico": "^3.0.2",
		"sharp": "^0.35.5",
		"style-loader": "^0.21.0",
		"terser-webpack-plugin": "^4.2.2",
		"typescript": "^4.6.3",
		"url-loader": "^1.0.1",
		"vue-html-loader": "^1.2.4",
		"vue-loader": "^15.2.4",
		"vue-style-loader": "^4.1.0",
		"vue-template-compiler": "^2.5.16",
		"webpack": "^4.15.1",
		"webpack-cli": "^3.0.8",
		"webpack-dev-server": "^3.1.4",
		"webpack-hot-middleware": "^2.22.2",
		"webpack-merge": "^4.1.3",
		"webpack-obfuscator": "^2.6.0"
	},
	"dependencies": {
		"element-ui": "^2.15.14"
	}
}
